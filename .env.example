# JARVIS Pro — Environment Variables
# Copy this to .env and fill in your values

# Database (auto-set by Railway when using their Postgres plugin)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# MCP endpoint secret — protects your MCP endpoint from unauthorized access
# Generate one: openssl rand -hex 16
MCP_SECRET=

# OpenAI API key (optional — enables text-to-speech)
# OPENAI_API_KEY=sk-...

# Claude model for in-app chat (optional, default: claude-sonnet-5)
# JARVIS_MODEL=claude-sonnet-5

# Feedback webhook URL (optional — forwards feedback to Slack, Google Sheet, etc.)
# FEEDBACK_WEBHOOK_URL=https://hooks.slack.com/...

# Timezone (optional, default: America/New_York)
# TZ=America/New_York
